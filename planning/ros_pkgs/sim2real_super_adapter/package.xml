<?xml version="1.0"?>
<package format="2">
  <name>sim2real_super_adapter</name>
  <version>0.1.0</version>
  <description>Process-boundary adapter for the SUPER planning backend.</description>
  <maintainer email="dreamer198@users.noreply.github.com">dreamer198</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>quadrotor_msgs</depend>
  <depend>roscpp</depend>
  <depend>sensor_msgs</depend>
  <depend>sim2real_planning_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>super_planner</depend>
  <depend>trajectory_msgs</depend>
  <depend>visualization_msgs</depend>

  <test_depend>rostest</test_depend>
  <test_depend>python3-nose</test_depend>
  <test_depend>python3-yaml</test_depend>

  <export/>
</package>

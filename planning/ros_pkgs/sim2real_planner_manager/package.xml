<?xml version="1.0"?>
<package format="2">
  <name>sim2real_planner_manager</name>
  <version>0.1.0</version>
  <description>Discovery, process isolation, and safety gateway for planner plugins.</description>

  <maintainer email="dreamer198@users.noreply.github.com">dreamer198</maintainer>
  <license>GPL-3.0-only</license>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>geometry_msgs</depend>
  <depend>mavros_msgs</depend>
  <depend>rospy</depend>
  <depend>sensor_msgs</depend>
  <depend>sim2real_planning_msgs</depend>
  <depend>std_srvs</depend>
  <depend>trajectory_msgs</depend>
  <depend>visualization_msgs</depend>

  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-numpy</exec_depend>

  <test_depend>python3-nose</test_depend>
  <test_depend>python3-numpy</test_depend>
  <test_depend>python3-yaml</test_depend>

  <export/>
</package>

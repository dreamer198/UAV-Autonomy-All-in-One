Panels:
  - Class: rviz/Displays
    Help Height: 70
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Recorded point clouds1
        - /Localization1
        - /Planning1
      Splitter Ratio: 0.5
    Tree Height: 650
  - Class: rviz/Selection
    Name: Selection
  - Class: rviz/Views
    Expanded:
      - /Current View1
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.4
      Cell Size: 0.5
      Class: rviz/Grid
      Color: 110; 115; 122
      Enabled: true
      Line Style:
        Line Width: 0.02
        Value: Lines
      Name: Grid
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 50
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz/Group
      Displays:
        - Alpha: 0.75
          Autocompute Intensity Bounds: true
          Autocompute Value Bounds:
            Max Value: 3
            Min Value: -1
            Value: true
          Axis: Z
          Channel Name: intensity
          Class: rviz/PointCloud2
          Color: 110; 210; 255
          Color Transformer: AxisColor
          Decay Time: 1.0
          Enabled: false
          Invert Rainbow: false
          Max Color: 255; 100; 60
          Min Color: 45; 145; 255
          Name: High-density registered scan (body + TF)
          Position Transformer: XYZ
          Queue Size: 8
          Selectable: false
          Size (Pixels): 2
          Size (m): 0.02
          Style: Points
          Topic: /cloud_registered_body
          Unreliable: false
          Use Fixed Frame: true
          Use rainbow: true
          Value: false
        - Alpha: 0.75
          Autocompute Intensity Bounds: false
          Autocompute Value Bounds:
            Max Value: 3
            Min Value: -1
            Value: true
          Axis: Z
          Channel Name: intensity
          Class: rviz/PointCloud2
          Color: 255; 210; 80
          Color Transformer: Intensity
          Decay Time: 0.5
          Enabled: true
          Invert Rainbow: false
          Max Color: 255; 245; 170
          Max Intensity: 255
          Min Color: 65; 110; 255
          Min Intensity: 0
          Name: Raw-density Livox cloud
          Position Transformer: XYZ
          Queue Size: 8
          Selectable: false
          Size (Pixels): 2
          Size (m): 0.02
          Style: Points
          Topic: /livox/lidar_points
          Unreliable: false
          Use Fixed Frame: true
          Use rainbow: true
          Value: true
      Enabled: true
      Name: Recorded point clouds
    - Class: rviz/Group
      Displays:
        - Alpha: 0.35
          Autocompute Intensity Bounds: true
          Autocompute Value Bounds:
            Max Value: 3
            Min Value: 0
            Value: true
          Axis: Z
          Channel Name: intensity
          Class: rviz/PointCloud2
          Color: 130; 190; 220
          Color Transformer: AxisColor
          Decay Time: 3600
          Enabled: true
          Invert Rainbow: false
          Max Color: 255; 175; 55
          Min Color: 55; 170; 220
          Name: Accumulated scene map (world)
          Position Transformer: XYZ
          Queue Size: 20
          Selectable: false
          Size (Pixels): 2
          Size (m): 0.03
          Style: Points
          Topic: /localization/cloud_registered
          Unreliable: false
          Use Fixed Frame: true
          Use rainbow: true
          Value: true
        - Angle Tolerance: 0.1
          Class: rviz/Odometry
          Covariance:
            Orientation:
              Alpha: 0.4
              Color: 255; 255; 127
              Scale: 1
              Value: false
            Position:
              Alpha: 0.3
              Color: 204; 51; 204
              Scale: 1
              Value: false
            Value: false
          Enabled: true
          Keep: 1000
          Name: Vehicle trajectory
          Position Tolerance: 0.02
          Shape:
            Alpha: 1
            Axes Length: 0.35
            Axes Radius: 0.035
            Color: 255; 255; 255
            Head Length: 0.25
            Head Radius: 0.08
            Shaft Length: 0.8
            Shaft Radius: 0.04
            Value: Axes
          Topic: /localization/odom
          Unreliable: false
          Value: true
        - Class: rviz/TF
          Enabled: false
          Frame Timeout: 15
          Frames:
            All Enabled: true
          Marker Scale: 0.5
          Name: TF
          Show Arrows: true
          Show Axes: true
          Show Names: false
          Tree: {}
          Update Interval: 0
          Value: false
      Enabled: true
      Name: Localization
    - Class: rviz/Group
      Displays:
        - Alpha: 0.28
          Autocompute Value Bounds:
            Max Value: 3
            Min Value: 0
            Value: false
          Axis: Z
          Channel Name: intensity
          Class: rviz/PointCloud2
          Color: 80; 190; 220
          Color Transformer: AxisColor
          Decay Time: 0
          Enabled: true
          Invert Rainbow: false
          Max Color: 255; 175; 55
          Min Color: 55; 170; 220
          Name: Inflated occupancy
          Position Transformer: XYZ
          Queue Size: 5
          Selectable: false
          Size (Pixels): 2
          Size (m): 0.15
          Style: Boxes
          Topic: /drone_0_diff_planner_node/grid_map/occupancy_inflate
          Unreliable: false
          Use Fixed Frame: true
          Use rainbow: false
          Value: true
      Enabled: true
      Name: Planning
  Enabled: true
  Global Options:
    Background Color: 20; 23; 27
    Default Light: true
    Fixed Frame: world
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/Interact
      Hide Inactive Objects: true
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/FocusCamera
    - Class: rviz/Measure
  Value: true
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 7
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.06
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Focal Point:
        X: 0
        Y: 0
        Z: 0.5
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 0.62
      Target Frame: base_link
      Yaw: 0.78
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Height: 900
  Hide Left Dock: false
  Hide Right Dock: true
  Selection:
    collapsed: false
  Views:
    collapsed: false
  Width: 1440
  X: 40
  Y: 40

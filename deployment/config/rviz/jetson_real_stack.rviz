Panels:
  - Class: sim2real_ground_station/InteractiveGoalPanel
    Goal Height: 1.5
    Name: Target Control
    Takeoff Height: 1.5
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.45
      Cell Size: 0.5
      Class: rviz/Grid
      Color: 120; 125; 130
      Enabled: true
      Line Style:
        Line Width: 0.02
        Value: Lines
      Name: Grid
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 40
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz/Group
      Displays:
        - Alpha: 0.9
          Autocompute Intensity Bounds: true
          Autocompute Value Bounds:
            Max Value: 3
            Min Value: 0
            Value: true
          Axis: Z
          Channel Name: intensity
          Class: rviz/PointCloud2
          Color: 205; 210; 215
          Color Transformer: FlatColor
          Decay Time: 0
          Enabled: true
          Invert Rainbow: false
          Name: Persistent obstacles
          Position Transformer: XYZ
          Queue Size: 2
          Selectable: false
          Size (Pixels): 4
          Size (m): 0.04
          Style: Points
          Topic: /planning/viz/environment
          Unreliable: false
          Use Fixed Frame: true
          Use rainbow: false
          Value: true
        - Alpha: 0.9
          Autocompute Intensity Bounds: true
          Autocompute Value Bounds:
            Max Value: 3
            Min Value: 0
            Value: true
          Axis: Z
          Channel Name: intensity
          Class: rviz/PointCloud2
          Color: 120; 200; 255
          Color Transformer: AxisColor
          Decay Time: 0.8
          Enabled: false
          Invert Rainbow: false
          Max Color: 255; 80; 60
          Min Color: 60; 150; 255
          Name: Registered cloud
          Position Transformer: XYZ
          Queue Size: 12
          Selectable: false
          Size (Pixels): 2
          Size (m): 0.025
          Style: Points
          Topic: /localization/cloud_registered
          Unreliable: false
          Use Fixed Frame: true
          Use rainbow: true
          Value: false
        - Angle Tolerance: 0.1
          Class: rviz/Odometry
          Covariance:
            Orientation:
              Alpha: 0.5
              Color: 255; 255; 127
              Scale: 1
              Value: false
            Position:
              Alpha: 0.3
              Color: 204; 51; 204
              Scale: 1
              Value: false
            Value: false
          Enabled: true
          Keep: 1
          Name: UAV pose
          Position Tolerance: 0.02
          Shape:
            Alpha: 1
            Axes Length: 0.55
            Axes Radius: 0.045
            Color: 255; 255; 255
            Head Length: 0.25
            Head Radius: 0.08
            Shaft Length: 0.8
            Shaft Radius: 0.04
            Value: Axes
          Topic: /localization/odom
          Unreliable: false
          Value: true
      Enabled: true
      Name: Sensors
    - Class: rviz/Group
      Displays:
        - Class: rviz/Marker
          Enabled: true
          Marker Topic: /planning/viz/planning_bounds
          Name: Fixed planning bounds
          Namespaces:
            fixed_planning_bounds: true
          Queue Size: 2
          Value: true
        - Alpha: 1
          Class: rviz/PointCloud2
          Color: 185; 75; 255
          Color Transformer: FlatColor
          Decay Time: 0
          Enabled: true
          Name: Observed obstacles
          Position Transformer: XYZ
          Queue Size: 3
          Selectable: false
          Size (Pixels): 5
          Size (m): 0.065
          Style: Points
          Topic: /planning/viz/occupancy
          Unreliable: false
          Use Fixed Frame: true
          Value: true
        - Alpha: 0.95
          Autocompute Intensity Bounds: true
          Autocompute Value Bounds:
            Max Value: 3.2
            Min Value: 0.36
            Value: false
          Axis: Z
          Channel Name: intensity
          Class: rviz/PointCloud2
          Color: 255; 255; 255
          Color Transformer: AxisColor
          Decay Time: 0
          Enabled: true
          Invert Rainbow: false
          Max Color: 255; 70; 45
          Min Color: 45; 105; 255
          Name: Safety clearance
          Position Transformer: XYZ
          Queue Size: 3
          Selectable: false
          Size (Pixels): 4
          Size (m): 0.06
          Style: Points
          Topic: /planning/viz/inflated_occupancy
          Unreliable: false
          Use Fixed Frame: true
          Use rainbow: true
          Value: true
      Enabled: true
      Name: Mapping
    - Class: rviz/Group
      Displays:
        - Class: rviz/Marker
          Enabled: true
          Marker Topic: /planning/viz/active_goal
          Name: Active planner goal
          Namespaces:
            active_planner_goal: true
          Queue Size: 2
          Value: true
        - Class: rviz/Marker
          Enabled: true
          Marker Topic: /planning/viz/executed_path
          Name: Actual flight trajectory
          Namespaces:
            measured_flight_path: true
          Queue Size: 2
          Value: true
        - Class: rviz/Marker
          Enabled: true
          Marker Topic: /planning/viz/backend/global_trajectory
          Name: Backend initial path
          Namespaces:
            {}
          Queue Size: 20
          Value: true
        - Class: rviz/Marker
          Enabled: true
          Marker Topic: /planning/viz/backend/trajectory
          Name: Backend trajectory
          Namespaces:
            {}
          Queue Size: 20
          Value: true
      Enabled: true
      Name: Planning
  Enabled: true
  Global Options:
    Background Color: 24; 27; 31
    Default Light: true
    Fixed Frame: world
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/Interact
      Hide Inactive Objects: true
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/FocusCamera
    - Class: rviz/Measure
    - Class: rviz/SetGoal
      Topic: /ground_station/goal_candidate
  Value: true
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 7
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.06
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Focal Point:
        X: 0
        Y: 0
        Z: 0.5
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 0.62
      Target Frame: base_link
      Yaw: 0.78
    Saved: ~
Window Geometry:
  Height: 900
  Hide Left Dock: false
  Hide Right Dock: false
  Target Control:
    collapsed: false
  Width: 1440
  X: 40
  Y: 40

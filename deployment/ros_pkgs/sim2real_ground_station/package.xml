<?xml version="1.0"?>
<package format="2">
  <name>sim2real_ground_station</name>
  <version>0.1.0</version>
  <description>Embedded RViz and guarded interactive-goal panel for the fixed UAV ground station.</description>
  <maintainer email="dreamer198@users.noreply.github.com">dreamer198</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>actionlib</depend>
  <depend>geometry_msgs</depend>
  <depend>mavros_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>pluginlib</depend>
  <depend>python_qt_binding</depend>
  <depend>roscpp</depend>
  <depend>rospy</depend>
  <depend>rviz</depend>
  <depend>sensor_msgs</depend>
  <depend>sim2real_planning_msgs</depend>

  <export>
    <rviz plugin="${prefix}/plugin_description.xml"/>
  </export>
</package>

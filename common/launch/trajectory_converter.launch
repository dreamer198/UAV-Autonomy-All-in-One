<launch>
  <!-- Deprecated compatibility shim.
       /command/trajectory has exactly one publisher: planner_gateway.
       Native planner messages are converted inside the selected backend
       adapter, so launching a second converter would bypass the safety gate. -->
  <arg name="drone_id" default="0"/>
  <arg name="command_topic" default="/drone_$(arg drone_id)_planning/pos_cmd"/>
  <arg name="poly_traj_topic" default="/drone_$(arg drone_id)_planning/trajectory"/>
  <arg name="output_topic" default="/command/trajectory"/>
  <arg name="require_offboard" default="true"/>
  <arg name="replay_cached_goal_on_offboard" default="false"/>
</launch>

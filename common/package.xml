<?xml version="1.0"?>
<package format="2">
  <name>sim2real_common</name>
  <version>0.1.0</version>
  <description>Shared planner bringup, trajectory conversion, SE3 controller configuration, and goal adapter.</description>
  <maintainer email="dreamer198@users.noreply.github.com">dreamer198</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>geometry_msgs</depend>
  <depend>mavros_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>rospy</depend>
  <depend>sim2real_planning_msgs</depend>
  <depend>std_srvs</depend>
  <exec_depend>rosgraph</exec_depend>
  <exec_depend>se3_controller</exec_depend>
  <exec_depend>sim2real_planner_manager</exec_depend>

  <test_depend>python3-nose</test_depend>
  <test_depend>python3-yaml</test_depend>

  <export/>
</package>

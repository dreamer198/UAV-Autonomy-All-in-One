<launch>
    <arg name="odom_topic" value="/Odometry_base"/>
    <arg name="drone_id" value="$(env DRONE_ID)"/>
    <arg name="inflation_size" default="0.15"/>
    <arg name="max_vel" default="0.5"/>
    <arg name="max_acc" default="0.8"/>
    <arg name="max_jer" default="8.0"/>
    <arg name="yaw_dot_max_deg_s" default="35.0"/>
    <arg name="yaw_dot_dot_max_deg_s2" default="90.0"/>

    <include file="$(find diff_planner)/launch/include/advanced_param_exp.xml">
        <arg name="odom_topic" value="$(arg odom_topic)"/>
        <arg name="drone_id" value="$(arg drone_id)"/>
        <arg name="camera_pose_topic" value="no_use0"/>
        <arg name="depth_topic" value="no_use1"/>
        <arg name="cloud_topic" value="/cloud_registered"/>
        <arg name="cx" value="319.31427001953125"/>
        <arg name="cy" value="239.09725952148438"/>
        <arg name="fx" value="386.2706298828125"/>
        <arg name="fy" value="386.2706298828125"/>
        <arg name="max_vel" value="$(arg max_vel)"/>
        <arg name="max_acc" value="$(arg max_acc)"/>
        <arg name="max_jer" value="$(arg max_jer)"/>
        <arg name="planning_horizon" value="3.0"/>
        <arg name="local_map_size_x" value="4.0"/>
        <arg name="local_map_size_y" value="4.0"/>
        <arg name="local_map_size_z" value="1.8"/>
        <arg name="enable_virtual_wall" value="true"/>
        <arg name="virtual_ceil" value="1.6"/>
        <arg name="virtual_ground" value="0.1"/>
        <arg name="map_resolution" value="0.15"/>
        <arg name="inflation_size" value="$(arg inflation_size)"/>
        <arg name="flight_type" value="1"/>
        <arg name="point_num" value="2"/>
        <arg name="point0_x" value="1.0"/>
        <arg name="point0_y" value="0.0"/>
        <arg name="point0_z" value="0.8"/>
        <arg name="point1_x" value="0.0"/>
        <arg name="point1_y" value="0.0"/>
        <arg name="point1_z" value="0.8"/>
        <arg name="point2_x" value="0.0"/>
        <arg name="point2_y" value="0.0"/>
        <arg name="point2_z" value="0.8"/>
        <arg name="point3_x" value="0.0"/>
        <arg name="point3_y" value="0.0"/>
        <arg name="point3_z" value="0.8"/>
        <arg name="point4_x" value="0.0"/>
        <arg name="point4_y" value="0.0"/>
        <arg name="point4_z" value="0.8"/>
    </include>

    <node pkg="diff_planner" name="drone_$(arg drone_id)_traj_server" type="traj_server" output="screen">
        <remap from="position_cmd" to="/drone_0_planning/pos_cmd"/>
        <remap from="~planning/trajectory" to="/drone_$(arg drone_id)_planning/trajectory"/>
        <remap from="~planning/yaw" to="/drone_$(arg drone_id)_planning/yaw"/>
        <remap from="~heartbeat" to="/drone_$(arg drone_id)_traj_server/heartbeat"/>
        <param name="traj_server/time_forward" value="1.0" type="double"/>
        <param name="traj_server/yaw_dot_max_deg_s" value="$(arg yaw_dot_max_deg_s)" type="double"/>
        <param name="traj_server/yaw_dot_dot_max_deg_s2" value="$(arg yaw_dot_dot_max_deg_s2)" type="double"/>
    </node>
</launch>

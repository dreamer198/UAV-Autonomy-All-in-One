<?xml version="1.0" encoding="utf-8"?>
<launch>
  <node pkg="se3_controller" type="se3_controller_node" name="se3_controller_node" output="screen">
    <param name="enable_sim" value="false" />
    <param name="takeoff_height" value="0.8" />
    <param name="geo_fence/x" value="10.0"/>
    <param name="geo_fence/y" value="10.0"/>
    <param name="geo_fence/z" value="1.6"/>
  </node>

  <node pkg="rqt_reconfigure" type="rqt_reconfigure" name="rqt_reconfigure"></node>

</launch>

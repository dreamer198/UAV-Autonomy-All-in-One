<?xml version="1.0"?>
<package format="2">
  <name>sim2real_simulation</name>
  <version>0.1.0</version>
  <description>Simulation-only localization, point-cloud, and PX4 SITL adapters.</description>
  <maintainer email="dreamer198@users.noreply.github.com">dreamer198</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>catkin</buildtool_depend>
  <depend>geometry_msgs</depend>
  <depend>mavros_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>rospy</depend>
  <exec_depend>rosbag</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <depend>sensor_msgs</depend>
  <depend>tf</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_sensor_msgs</depend>
  <test_depend>python3-nose</test_depend>
  <export/>
</package>
